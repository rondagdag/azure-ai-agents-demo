{
  "name": "azure-ai-agents",
  "version": "1.0.0",
  "description": "Azure AI Agents QuickStart demo",
  "license": "ISC",
  "author": "Dan Wahlin",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "1": "tsx ./examples/1-basic.ts",
    "2": "tsx ./examples/2-threads.ts",
    "3": "tsx ./examples/3-messages.ts",
    "4": "tsx ./examples/4-streaming.ts",
    "5": "tsx ./examples/5-run.ts",
    "6": "tsx ./examples/6-agentAttachment.ts",
    "7": "tsx ./examples/7-callExisting.ts",
    "8": "tsx ./examples/8-codeInterpreter.ts",
    "9": "tsx ./examples/9-deleteAllAgents.ts",
    "build": "npx tsc"
  },
  "dependencies": {
    "@azure/ai-agents": "^1.1.0",
    "@azure/ai-projects": "^1.0.0",
    "@azure/identity": "^4.12.0",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  },
  "tsconfig": {
    "compilerOptions": {
      "target": "ES2020",
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
      "outDir": "dist",
      "rootDir": ".",
      "strict": true,
      "esModuleInterop": true
    },
    "include": [
      "examples/**/*"
    ],
    "exclude": [
      "node_modules"
    ]
  }
}
